@propdef --tw-inset-ring-shadow: 0 0 #0000
@propdef --tw-ring-offset-width: 0px
@propdef --tw-ring-offset-color: #fff
@propdef --tw-ring-offset-shadow: 0 0 #0000
@propdef --tw-outline-style: solid
@propdef --tw-drop-shadow-alpha: 100%
@propdef --tw-content: ""
@entry shadcn selection:bg-primary
.selection\:bg-primary {
& *::selection {
      background-color: var(--primary);
    }
    &::selection {
      background-color: var(--primary);
    }
}
@end
@entry shadcn placeholder:text-muted-foreground
.placeholder\:text-muted-foreground {
&::placeholder {
      color: var(--muted-foreground);
    }
}
@end
@entry shadcn bg-primary
.bg-primary {
background-color: var(--primary);
}
@end
@entry shadcn text-primary-foreground
.text-primary-foreground {
color: var(--primary-foreground);
}
@end
@entry shadcn bg-primary/90
.bg-primary\/90 {
background-color: var(--primary);
    @supports (color: color-mix(in lab, red, red)) {
      background-color: color-mix(in oklab, var(--primary) 90%, transparent);
    }
}
@end
@entry shadcn border-border
.border-border {
border-color: var(--border);
}
@end
@entry shadcn ring-ring/50
.ring-ring\/50 {
--tw-ring-color: var(--ring);
    @supports (color: color-mix(in lab, red, red)) {
      --tw-ring-color: color-mix(in oklab, var(--ring) 50%, transparent);
    }
}
@end
@entry shadcn rounded-md
.rounded-md {
border-radius: calc(var(--radius) - 2px);
}
@end
@entry shadcn bg-destructive
.bg-destructive {
background-color: var(--destructive);
}
@end
@entry shadcn text-muted-foreground
.text-muted-foreground {
color: var(--muted-foreground);
}
@end
@entry shadcn focus-visible:ring-ring/50
.focus-visible\:ring-ring\/50 {
&:focus-visible {
      --tw-ring-color: var(--ring);
      @supports (color: color-mix(in lab, red, red)) {
        --tw-ring-color: color-mix(in oklab, var(--ring) 50%, transparent);
      }
    }
}
@end
@entry shadcn bg-sidebar
.bg-sidebar {
background-color: var(--sidebar);
}
@end
@entry shadcn tracking-normal
.tracking-normal {
--tw-tracking: var(--tracking-normal);
    letter-spacing: var(--tracking-normal);
}
@end
@entry shadcn leading-relaxed
.leading-relaxed {
--tw-leading: var(--leading-relaxed);
    line-height: var(--leading-relaxed);
}
@end
@entry shadcn bg-background
.bg-background {
background-color: var(--background);
}
@end
@entry shadcn text-foreground
.text-foreground {
color: var(--foreground);
}
@end
@entry shadcn bg-secondary
.bg-secondary {
background-color: var(--secondary);
}
@end
@entry shadcn text-secondary-foreground
.text-secondary-foreground {
color: var(--secondary-foreground);
}
@end
@entry shadcn bg-muted
.bg-muted {
background-color: var(--muted);
}
@end
@entry shadcn bg-accent
.bg-accent {
background-color: var(--accent);
}
@end
@entry shadcn text-accent-foreground
.text-accent-foreground {
color: var(--accent-foreground);
}
@end
@entry shadcn bg-card
.bg-card {
background-color: var(--card);
}
@end
@entry shadcn text-card-foreground
.text-card-foreground {
color: var(--card-foreground);
}
@end
@entry shadcn bg-popover
.bg-popover {
background-color: var(--popover);
}
@end
@entry shadcn text-popover-foreground
.text-popover-foreground {
color: var(--popover-foreground);
}
@end
@entry shadcn border-input
.border-input {
border-color: var(--input);
}
@end
@entry shadcn ring-ring
.ring-ring {
--tw-ring-color: var(--ring);
}
@end
@entry shadcn ring-destructive
.ring-destructive {
--tw-ring-color: var(--destructive);
}
@end
@entry shadcn bg-sidebar-border
.bg-sidebar-border {
background-color: var(--sidebar-border);
}
@end
@entry shadcn outline-ring
.outline-ring {
outline-color: var(--ring);
}
@end
@entry shadcn decoration-destructive
.decoration-destructive {
text-decoration-color: var(--destructive);
}
@end
@entry shadcn bg-primary/50
.bg-primary\/50 {
background-color: var(--primary);
    @supports (color: color-mix(in lab, red, red)) {
      background-color: color-mix(in oklab, var(--primary) 50%, transparent);
    }
}
@end
@entry shadcn text-muted-foreground/70
.text-muted-foreground\/70 {
color: var(--muted-foreground);
    @supports (color: color-mix(in lab, red, red)) {
      color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
    }
}
@end
@entry shadcn border-border/60
.border-border\/60 {
border-color: var(--border);
    @supports (color: color-mix(in lab, red, red)) {
      border-color: color-mix(in oklab, var(--border) 60%, transparent);
    }
}
@end
@entry shadcn rounded-lg
.rounded-lg {
border-radius: var(--radius);
}
@end
@entry shadcn hover:bg-accent
.hover\:bg-accent {
&:hover {
      @media (hover: hover) {
        background-color: var(--accent);
      }
    }
}
@end
@entry shadcn dark:bg-input/30
.dark\:bg-input\/30 {
@media (prefers-color-scheme: dark) {
      background-color: var(--input);
      @supports (color: color-mix(in lab, red, red)) {
        background-color: color-mix(in oklab, var(--input) 30%, transparent);
      }
    }
}
@end
@entry shadcn aria-invalid:border-destructive
.aria-invalid\:border-destructive {
&[aria-invalid="true"] {
      border-color: var(--destructive);
    }
}
@end
@entry shadcn file:text-foreground
.file\:text-foreground {
&::file-selector-button {
      color: var(--foreground);
    }
}
@end
@entry shadcn marker:text-primary
.marker\:text-primary {
& *::marker {
      color: var(--primary);
    }
    &::marker {
      color: var(--primary);
    }
    & *::-webkit-details-marker {
      color: var(--primary);
    }
    &::-webkit-details-marker {
      color: var(--primary);
    }
}
@end
@entry shadcn group-hover/card:bg-card
.group-hover\/card\:bg-card {
&:is(:where(.group\/card):hover *) {
      @media (hover: hover) {
        background-color: var(--card);
      }
    }
}
@end
